# ============================================================
# FlowForge Environment Configuration
# ============================================================

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://flowforge:flowforge_secret@localhost:5432/flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge_secret
POSTGRES_DB=flowforge

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Credential Encryption (AES-256-GCM 32-byte hex key = 64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Backend API
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
WORKER_CONCURRENCY=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# AI Integrations (Optional default keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
