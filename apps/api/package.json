{
  "name": "@autozure/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -e \"const fs=require('fs');const p=fs.existsSync('./dist/apps/api/src/index.js')?'./dist/apps/api/src/index.js':'./dist/index.js';require(p);\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@autozure/types": "workspace:*",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.2.0",
    "drizzle-orm": "^0.30.10",
    "pg": "^8.11.5",
    "drizzle-kit": "^0.21.4",
    "ioredis": "^5.3.2",
    "bullmq": "^5.8.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "uuid": "^9.0.1",
    "node-cron": "^3.0.3",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0",
    "date-fns": "^3.6.0",
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.26.0",
    "@google/generative-ai": "^0.15.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.12.0",
    "tsx": "^4.10.5",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
